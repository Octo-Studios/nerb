  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "architectury": ">=19.0.1",
    "shatterlib": ">=0.6.0.8",
    "fabric-api": "*"
  }
}
